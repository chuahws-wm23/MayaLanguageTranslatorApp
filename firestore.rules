rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != "suspended";
    }

    function isAdmin() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if owns(userId)
        && request.resource.data.userId == userId
        && request.resource.data.role == "user";

      allow read: if owns(userId) || isAdmin();

      allow update: if owns(userId)
        && isActiveUser()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus;

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /dictionary/{entryId} {
      allow read: if isActiveUser() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /translations/{translationId} {
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && (
          (isActiveUser() && resource.data.userId == request.auth.uid)
          || isAdmin()
        );

      allow update: if false;

      allow delete: if isActiveUser()
        && resource.data.userId == request.auth.uid;
    }

    match /savedVocabulary/{savedId} {
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;

      allow read, delete: if isActiveUser()
        && resource.data.userId == request.auth.uid;

      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /analytics/{userId} {
      allow read: if (owns(userId) && isActiveUser()) || isAdmin();
      allow create, update: if owns(userId) && isActiveUser();
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && (
          (isActiveUser() && resource.data.userId == request.auth.uid)
          || isAdmin()
        );

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
